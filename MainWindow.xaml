<Window x:Class="WpfImageReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfImageReader"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="850">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="10">
            <Button x:Name="btnDownload"
                    Padding="12,6"
                    Content="Завантажити фото" Click="btnDownload_Click"/>

            <TextBox Padding="12,6"
                     Width="400" 
                     Margin="20,0,0,0" 
                     x:Name="txtUrl"/>

            <Button x:Name="btnReadImages"
                    Click="btnReadFolder_Click"
                    Padding="12,6"
                    Content="Читання з папки" RenderTransformOrigin="0.578,0.512" Width="161"/>
        </WrapPanel>
        <ListBox Name="GalleryList" Grid.Row="1" Margin="10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding}" Width="150" Height="150"
                           Stretch="UniformToFill" Margin="5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>
    </Grid>
</Window>
